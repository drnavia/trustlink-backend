# Servidor Express
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL (usar DATABASE_URL en nube o DB_* en local)
# DATABASE_URL=postgresql://user:password@host:5432/trustlink_db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trustlink_db
DB_USER=postgres
DB_PASSWORD=replace_with_db_password
# DB_SSL=true

# Seguridad JWT (usar un secreto aleatorio largo de al menos 32 caracteres en produccion)
JWT_SECRET=replace_with_strong_random_jwt_secret

# CORS: lista separada por comas de origenes permitidos en produccion
# CORS_ORIGINS=https://tu-frontend.vercel.app,http://localhost:5173

# Webhook de pagos (obligatorio para habilitar POST /api/v1/payments/webhook)
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_hmac_secret

# Pasarela de pagos Mercado Pago (modo dual: 'mock' para piloto/tests o 'mercadopago' real)
PAYMENT_GATEWAY_MODE=mock
# MP_ACCESS_TOKEN=TEST-replace_with_mercadopago_access_token
# MP_PLATFORM_FEE_PERCENT=7
# MP_SANDBOX=true
# MP_PUBLIC_APP_URL=https://tu-frontend.vercel.app
# MP_WEBHOOK_URL=https://tu-backend.up.railway.app/api/v1/payments/webhook

# Opcional: clave global de respaldo para API externa de garitas
# EXTERNAL_GATE_API_KEY=replace_with_external_gate_api_key
